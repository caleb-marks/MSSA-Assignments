<Window x:Class="Caleb_Marks_Assignment_10._3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Caleb_Marks_Assignment_10._3"
        mc:Ignorable="d"
        Title="Car Inventory" Height="560" Width="1200" MinHeight="560" MinWidth="1200">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Car records -->
        <DataGrid x:Name="CarGrid" Grid.Column="0" Margin="5" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" />

        <!-- Car form -->
        <StackPanel Grid.Column="1" Margin="5">
            <Label Content="Car ID" />
            <TextBox x:Name="txtId" IsReadOnly="True" />
            <Label Content="VIN" />
            <TextBox x:Name="txtVin" />
            <Label Content="Make" />
            <TextBox x:Name="txtMake" />
            <Label Content="Model" />
            <TextBox x:Name="txtModel" />
            <Label Content="Year" />
            <TextBox x:Name="txtYear" />
            <Label Content="Price" />
            <TextBox x:Name="txtPrice" />

            <WrapPanel Margin="0,20,0,0">
                <Button x:Name="btnAddNew" Width="80" Margin="3" Content="Add New" Click="btnAddNew_Click" />
                <Button x:Name="btnSubmit" Width="80" Margin="3" Content="Submit" Click="btnSubmit_Click" />
                <Button x:Name="btnSelect" Width="100" Margin="3" Content="Select to update" Click="btnSelect_Click" />
                <Button x:Name="btnDelete" Width="80" Margin="3" Content="Delete" Click="btnDelete_Click" />
                <Button x:Name="btnUpdate" Width="80" Margin="3" Content="Update" Click="btnUpdate_Click" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
