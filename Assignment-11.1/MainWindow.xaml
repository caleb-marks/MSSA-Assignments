<Window x:Class="Caleb_Marks_Assignment_11._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Caleb_Marks_Assignment_11._1"
        mc:Ignorable="d"
        Title="Book Inventory" Height="530" Width="920" MinHeight="480" MinWidth="760">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Book records -->
        <DataGrid x:Name="BookGrid" Grid.Column="0" Margin="5" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="Auto" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Book form -->
        <StackPanel Grid.Column="1" Margin="5">
            <Label Content="ISBN (10 or 13 characters)" />
            <TextBox x:Name="txtIsbn" />
            <Label Content="Name" />
            <TextBox x:Name="txtName" />
            <Label Content="Author Name" />
            <TextBox x:Name="txtAuthor" />
            <Label Content="Description" />
            <TextBox x:Name="txtDescription" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            <Label Content="Quantity" />
            <TextBox x:Name="txtQuantity" />

            <WrapPanel Margin="0,20,0,0">
                <Button x:Name="btnAdd" Width="80" Margin="3" Content="Add" Click="btnAdd_Click" />
                <Button x:Name="btnSelect" Width="100" Margin="3" Content="Select to update" Click="btnSelect_Click" />
                <Button x:Name="btnUpdate" Width="80" Margin="3" Content="Update" Click="btnUpdate_Click" />
                <Button x:Name="btnDelete" Width="80" Margin="3" Content="Delete" Click="btnDelete_Click" />
                <Button x:Name="btnClear" Width="80" Margin="3" Content="Clear" Click="btnClear_Click" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
